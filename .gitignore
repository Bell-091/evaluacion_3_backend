# Entorno virtual y dependencias
.venv/
venv/
env/
ENV/

# Archivos de variables de entorno y secretos
.env
.env.local
.env.*.local

# Base de datos local SQLite (para no subir datos locales)
*.sqlite3
db.sqlite3

# Archivos multimedia subidos por usuarios durante pruebas
media/

# Archivos temporales y byte-code de Python
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Archivos de pautas y enunciados de la evaluación
*.pdf
Instrucciones_proyecto.txt

# Dependencias frontend o paquetes externos
node_modules/

# Configuraciones de editores e IDEs
.vscode/
.idea/
*.swp
*.swo

# Archivos de sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Logs y volcados de depuración
*.log
